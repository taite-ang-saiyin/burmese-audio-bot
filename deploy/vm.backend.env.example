# Copy this file to deploy/vm.backend.env on the VM. Do not commit the copy.
APP_NAME=Mingalar Banking API
APP_ENV=production
DATABASE_PATH=/app/data/banking.db
# Public VM address where the browser accesses the frontend. With the Nginx
# proxy, this is normally the only browser origin that needs to be allowed.
CORS_ORIGINS=https://copilot.example.com
SESSION_SECRET=replace-with-a-long-random-production-secret
SESSION_TTL_HOURS=24

# Private VPN/LAN addresses of the computer hosting your local models.
# Do not expose these model-service ports to the public Internet.
CHAT_SERVICE_URL=http://YOUR_MODEL_PC_VPN_IP:8002/chat
STT_SERVICE_URL=http://YOUR_MODEL_PC_VPN_IP:8001/api/v1/transcribe
TTS_SERVICE_URL=
REQUEST_TIMEOUT_SECONDS=900
