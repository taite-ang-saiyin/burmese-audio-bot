# Application
APP_NAME="Mingalar Banking API"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT="8000"
DATABASE_PATH="./data/banking.db"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Replace with a long random value before deploying. Do not commit a real value.
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_HOURS="24"

# Internal service endpoints. These include the target route, not just the
# service origin. TTS stays empty until its service is available.
CHAT_SERVICE_URL="http://127.0.0.1:8002/chat"
TTS_SERVICE_URL=""
STT_SERVICE_URL="http://127.0.0.1:8001/api/v1/transcribe"
# STT may require longer while the local Whisper model first loads.
REQUEST_TIMEOUT_SECONDS="900"
